# Salin ke variabel lingkungan (Railway: tab Variables). JANGAN commit nilai asli ke GitHub.
NODE_ENV=production            # production = pembayaran simulasi dimatikan, 3 secret di bawah WAJIB diisi
JWT_SECRET=isi-acak-min-32-karakter
ENC_KEY=isi-acak-min-32-karakter          # jangan diganti setelah ada pesanan berjalan (kredensial akun game dienkripsi dengan ini)
GATEWAY_SECRET=isi-acak-min-32-karakter
ADMIN_EMAIL=emailadmin@contoh.com         # akun admin awal
ADMIN_PASSWORD=sandi-admin-min-8-karakter
DATA_FILE=/data/data.json                 # arahkan ke Volume Railway (mount path /data) agar data tidak hilang saat redeploy
TRUST_PROXY=1                             # otomatis 1 di Railway; isi jika di belakang proxy lain
# PORT tidak perlu diisi: Railway menyuntikkannya sendiri (lokal bawaan 3000)
# Buat secret acak:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
